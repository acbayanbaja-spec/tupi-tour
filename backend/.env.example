PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000,https://*.vercel.app
# Supabase PostgreSQL Connection Pooler URL (recommended for Render & IPv4 networks):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
JWT_SECRET=generate-a-secure-random-secret-key-32-chars-or-more
JWT_REFRESH_SECRET=generate-another-secure-random-refresh-key-32-chars
GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
AI_API_KEY=
POLLINATIONS_REFERRER=tupi-tour.local
UPLOAD_DIR=./uploads
